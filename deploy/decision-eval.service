[Unit]
Description=Decision model evaluation worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/szq43/code/decision-model-eval
EnvironmentFile=/home/szq43/code/decision-model-eval/.env
ExecStart=/usr/bin/python3 eval.py watch --provider cloudflare --interval 3600
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
